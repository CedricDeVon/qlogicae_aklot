{
	"name": "qlogicae_aklot",
	"version": "1.1.0",
	"author": "Vaughn Cedric L. Araneta",
	"main": "./build/index.js",
	"module": "index.ts",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "latest",
		"@vitest/coverage-v8": "4.1.8",
		"esbuild": "^0.28.1",
		"eslint": "^10.4.1",
		"prettier": "^3.8.4",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vitest": "^4.1.8"
	},
	"description": "QLogicae Aklot",
	"files": [
		"build"
	],
	"license": "MIT",
	"private": false,
	"scripts": {
		"clean": "rimraf build",
		"format": "bunx prettier --write .",
		"format:check": "bunx prettier --check .",
		"lint": "bunx eslint .",
		"typescript": "bunx tsc",
		"build": "bun run clean && bun run format && bun run lint && bun esbuild.js && bunx typescript",
		"test": "bunx vitest run --coverage",
		"publish": "bun publish",
		"publish:initial": "bun publish --access public",
		"deploy": "bun run clean && bun run build && bun run publish:update",
		"deploy:initial": "bun run clean && bun run build && bun run publish:initial"
	},
	"type": "module",
	"types": "./build/index.d.ts"
}
